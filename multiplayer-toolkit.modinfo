<?xml version="1.0" encoding="utf-8"?>
<Mod id="multiplayer-toolkit" version="00620" xmlns="ModInfo">
	<Properties>
		<Name>LOC_MODULE_MPT_NAME</Name>
		<Description>LOC_MODULE_MPT_DESCRIPTION</Description>
		<Authors>Zatygold, Gohei427</Authors>
		<Version>0.6.2</Version>
		<Package>Mod</Package>
		<LastUpdated>2026-11-07</LastUpdated>
		<ShowInBrowser>1</ShowInBrowser>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
		<Mod id="age-antiquity" title="LOC_MODULE_AGE_ANTIQUITY_NAME"/>
		<Mod id="age-exploration" title="LOC_MODULE_AGE_EXPLORATION_NAME"/>
		<Mod id="age-modern" title="LOC_MODULE_AGE_MODERN_NAME"/>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet/>
		</Criteria>

<!--*************************** CRITERIA: COMPETITIVE TIMER ***************************************-->

		<!-- The current Age, for the per-Age Competitive timer numbers. -->
		<Criteria id="timer-antiquity">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
		</Criteria>
		<Criteria id="timer-exploration">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
		</Criteria>
		<Criteria id="timer-modern">
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>

<!--*************************** CRITERIA: BALANCE *************************************************-->

		<!-- The Multiplayer Balance lobby option, alone, per Age and with its victory threshold option. -->
		<Criteria id="balance-on">
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalance</ConfigurationId><Value>MPT_BALANCE_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="balance-antiquity">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalance</ConfigurationId><Value>MPT_BALANCE_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="balance-exploration">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalance</ConfigurationId><Value>MPT_BALANCE_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="balance-modern">
			<AgeInUse>AGE_MODERN</AgeInUse>
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalance</ConfigurationId><Value>MPT_BALANCE_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="balance-victory-threshold-low">
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalance</ConfigurationId><Value>MPT_BALANCE_ON</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalanceVictoryThresholdScale</ConfigurationId><Value>MPT_BALANCE_VICTORY_THRESHOLD_LOW</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="balance-victory-threshold-very-low">
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalance</ConfigurationId><Value>MPT_BALANCE_ON</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalanceVictoryThresholdScale</ConfigurationId><Value>MPT_BALANCE_VICTORY_THRESHOLD_VERY_LOW</Value></ConfigurationValueMatches>
		</Criteria>

<!--*************************** CRITERIA: MAPS ****************************************************-->

		<!-- The Custom Resource System lobby option (Map Options), alone and per Age. -->
		<Criteria id="maps-resource-system-on">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTResourceSystem</ConfigurationId><Value>MPT_MAPS_RESOURCE_SYSTEM_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-duel-placement">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTPlayerPlacement</ConfigurationId><Value>MPT_MAPS_PLACEMENT_DUEL</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-chosen-size-tiny">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTChosenMapSize</ConfigurationId><Value>MAPSIZE_TINY</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-chosen-size-small">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTChosenMapSize</ConfigurationId><Value>MAPSIZE_SMALL</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-resources-antiquity">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTResourceSystem</ConfigurationId><Value>MPT_MAPS_RESOURCE_SYSTEM_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-resources-exploration">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTResourceSystem</ConfigurationId><Value>MPT_MAPS_RESOURCE_SYSTEM_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-resources-modern">
			<AgeInUse>AGE_MODERN</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTResourceSystem</ConfigurationId><Value>MPT_MAPS_RESOURCE_SYSTEM_ON</Value></ConfigurationValueMatches>
		</Criteria>

		<!-- Map Settings carried over from Advanced Settings Pro (maps/config/map-settings.sql): Disasters, per Age when Custom. -->
		<Criteria id="maps-disasters-disabled">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_DISABLED</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-light">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_LIGHT</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-moderate">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_MODERATE</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-catastrophic">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_CATASTROPHIC</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-antiquity-disabled">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_CUSTOM</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisastersAntiquity</ConfigurationId><Value>MPT_MAPS_DISASTERS_DISABLED</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-antiquity-light">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_CUSTOM</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisastersAntiquity</ConfigurationId><Value>MPT_MAPS_DISASTERS_LIGHT</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-antiquity-moderate">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_CUSTOM</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisastersAntiquity</ConfigurationId><Value>MPT_MAPS_DISASTERS_MODERATE</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-antiquity-catastrophic">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_CUSTOM</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisastersAntiquity</ConfigurationId><Value>MPT_MAPS_DISASTERS_CATASTROPHIC</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-exploration-disabled">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_CUSTOM</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisastersExploration</ConfigurationId><Value>MPT_MAPS_DISASTERS_DISABLED</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-exploration-light">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_CUSTOM</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisastersExploration</ConfigurationId><Value>MPT_MAPS_DISASTERS_LIGHT</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-exploration-moderate">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_CUSTOM</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisastersExploration</ConfigurationId><Value>MPT_MAPS_DISASTERS_MODERATE</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-exploration-catastrophic">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_CUSTOM</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisastersExploration</ConfigurationId><Value>MPT_MAPS_DISASTERS_CATASTROPHIC</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-modern-disabled">
			<AgeInUse>AGE_MODERN</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_CUSTOM</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisastersModern</ConfigurationId><Value>MPT_MAPS_DISASTERS_DISABLED</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-modern-light">
			<AgeInUse>AGE_MODERN</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_CUSTOM</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisastersModern</ConfigurationId><Value>MPT_MAPS_DISASTERS_LIGHT</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-modern-moderate">
			<AgeInUse>AGE_MODERN</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_CUSTOM</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisastersModern</ConfigurationId><Value>MPT_MAPS_DISASTERS_MODERATE</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-disasters-modern-catastrophic">
			<AgeInUse>AGE_MODERN</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisasters</ConfigurationId><Value>MPT_MAPS_DISASTERS_CUSTOM</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTDisastersModern</ConfigurationId><Value>MPT_MAPS_DISASTERS_CATASTROPHIC</Value></ConfigurationValueMatches>
		</Criteria>

		<!-- Natural Wonders: count, spawn fixes while the setting exists, and one toggle per wonder. -->
		<Criteria id="maps-natural-wonders" any="true">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonders</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDERS_NONE</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonders</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDERS_HALF</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonders</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDERS_STANDARD</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonders</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDERS_MORE</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonders</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDERS_DOUBLE</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-natural-wonders-none">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonders</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDERS_NONE</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-natural-wonders-half">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonders</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDERS_HALF</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-natural-wonders-more">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonders</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDERS_MORE</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-natural-wonders-double">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonders</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDERS_DOUBLE</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-natural-wonder-off-barrier-reef">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonderBarrierReef</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDER_OFF</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-natural-wonder-off-bermuda-triangle">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonderBermudaTriangle</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDER_OFF</Value></ConfigurationValueMatches>

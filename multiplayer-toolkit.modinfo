		<Criteria id="maps-natural-wonder-off-kilimanjaro">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonderKilimanjaro</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDER_OFF</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-natural-wonder-off-machapuchare">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonderMachapuchare</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDER_OFF</Value></ConfigurationValueMatches>

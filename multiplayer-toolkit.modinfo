			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTResourceList</ConfigurationId><Value>MPT_MAPS_RESOURCE_LIST_ALL</Value></ConfigurationValueMatches>
		</Criteria>

		<!-- Natural Wonders: count, spawn fixes while the setting exists, and one toggle per wonder. -->

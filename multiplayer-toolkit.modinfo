				</UpdateText>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-balance-modern" scope="game" criteria="balance-modern">
			<Properties><LoadOrder>230</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>balance/data/civilizations/antiquity.sql</Item>
					<Item>balance/data/civilizations/exploration.sql</Item>
					<Item>balance/data/civilizations/modern.sql</Item>
					<Item>balance/data/constructibles/wonders.sql</Item>

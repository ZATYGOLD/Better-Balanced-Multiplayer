					<Item>balance/data/civilizations/civilizations-gameeffects.xml</Item>
					<Item>balance/data/attributes/attributes-gameeffects.xml</Item>
					<Item>balance/data/constructibles/constructibles.xml</Item>
					<Item>balance/data/constructibles/constructibles-gameeffects.xml</Item>
					<Item>balance/data/civilizations/antiquity.xml</Item>
					<Item>balance/data/attributes/antiquity-gameeffects.xml</Item>
					<Item>balance/data/attributes/attributes.sql</Item>
					<Item>balance/data/governments/antiquity-gameeffects.xml</Item>
					<Item>balance/data/governments/antiquity.xml</Item>
					<Item>balance/data/units/antiquity.sql</Item>
					<Item>balance/data/units/antiquity-tier3.xml</Item>
					<Item>balance/data/progression-trees/antiquity-gameeffects.xml</Item>

<!--*************************** SHELL: TEXT, SETTINGS, LOBBY UI, SETUP, KEYBINDS ******************-->
	<ActionGroups>
		<ActionGroup id="mpt-shell" scope="shell" criteria="always">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UpdateText>
					<Item>text/en_us/shared.xml</Item>
				</UpdateText>
				<UpdateDatabase>
					<Item>config/timer.sql</Item>
					<Item>config/input.sql</Item>
					<Item>config/match-types.sql</Item>
				</UpdateDatabase>
				<UIScripts>
					<Item>ui/shared/mpt-util.js</Item>
					<Item>ui/shared/mpt-setup.js</Item>
					<Item>ui/lobby/mp-lobby-config.js</Item>
					<Item>ui/lobby/mp-lobby-tooltips.js</Item>
					<Item>ui/lobby/mp-lobby-rules.js</Item>
					<Item>ui/lobby/mp-memento-select-model.js</Item>
					<Item>ui/lobby/mp-memento-select.js</Item>
					<Item>ui/lobby/mp-lobby-mementos.js</Item>
					<Item>ui/setup/setup-layout.js</Item>
					<Item>ui/setup/setup-tabs.js</Item>
					<Item>ui/setup/match-type-rules.js</Item>
					<Item>ui/timer/mp-timer-config.js</Item>
					<Item>ui/timer/mp-timer-lobby.js</Item>
					<Item>ui/keybind/mp-keybind-config.js</Item>
					<Item>ui/keybind/mp-keybind.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>

<!--*************************** GAME: TEXT & SHARED HELPERS ************************************************-->
		<ActionGroup id="mpt-game-text" scope="game" criteria="always">
			<Properties><LoadOrder>500</LoadOrder></Properties>
			<Actions>
				<UpdateText>
					<Item>text/en_us/shared.xml</Item>
				</UpdateText>
				<UIScripts>
					<Item>ui/shared/mpt-util.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>

<!--*************************** GAME: PAUSE, KEYBINDS ************************************************-->
		<ActionGroup id="mpt-pause-button" scope="game" criteria="always">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UIScripts>
					<Item>ui/pause/mp-pause-config.js</Item>
					<Item>ui/pause/mp-pause.scss.js</Item>
					<Item>ui/pause/mp-pause-overlay.js</Item>
					<Item>ui/pause/mp-pause-net.js</Item>
					<Item>ui/pause/mp-pause-mgr.js</Item>
					<Item>ui/keybind/mp-keybind-config.js</Item>
					<Item>ui/keybind/mp-keybind.js</Item>
					<Item>ui/keybind/mp-hotkeys.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>

<!--*************************** GAME: COMPETITIVE TIMER ************************************************-->
		<ActionGroup id="mpt-competitive-timer-script" scope="game" criteria="always">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UIScripts>
					<Item>ui/timer/mp-timer-config.js</Item>
					<Item>ui/timer/mp-timer.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>


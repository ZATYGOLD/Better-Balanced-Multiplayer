			<Actions>
				<UpdateDatabase>
					<Item>balance/data/victories/thresholds-very-low.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-balance-antiquity" scope="game" criteria="balance-antiquity">
			<Properties><LoadOrder>210</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>balance/data/civilizations/antiquity.sql</Item>

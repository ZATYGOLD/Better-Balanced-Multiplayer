<!--*************************** MAPS (from Multiplayer Map Mod) ***********************************-->

        <ActionGroup id="mpt-maps-shell" scope="shell" criteria="always">
            <Properties><LoadOrder>300</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>maps/config/map-options.xml</Item>
                    <Item>maps/config/multiplayer-only.sql</Item>
                    <Item>maps/config/compatibility.sql</Item>
                </UpdateDatabase>
                <UpdateText>
                    <Item>maps/text/en_us/MapText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <Item>maps/ui/multiplayer-defaults.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>

        <ActionGroup id="mpt-maps-game" scope="game" criteria="always">
            <Properties><LoadOrder>300</LoadOrder></Properties>
            <Actions>
                <MapGenScripts>
                    <Item>{multiplayer-toolkit}maps/scripts/global-team-starts.js</Item>
                </MapGenScripts>
                <UIScripts>
                    <Item>maps/ui/strict-start-bias-notification.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>

        <ActionGroup id="mpt-maps-resource-system" scope="game" criteria="maps-resource-system-on">
            <Properties><LoadOrder>310</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>maps/data/resource-system.sql</Item>
                    <Item>maps/data/density-standard.sql</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>

        <ActionGroup id="mpt-maps-resources-antiquity" scope="game" criteria="maps-resources-antiquity">
            <Properties><LoadOrder>350</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>maps/data/effects-reset.sql</Item>
                    <Item>maps/data/effects-common.xml</Item>
                    <Item>maps/data/effects-antiquity.sql</Item>
                    <Item>maps/data/effects-antiquity.xml</Item>
                    <Item>maps/data/classes-antiquity.sql</Item>
                </UpdateDatabase>
                <UpdateText>
                    <Item>maps/text/en_us/ResourceText.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>

        <ActionGroup id="mpt-maps-resources-exploration" scope="game" criteria="maps-resources-exploration">
            <Properties><LoadOrder>350</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>maps/data/effects-reset.sql</Item>
                    <Item>maps/data/effects-common.xml</Item>
                    <Item>maps/data/effects-exploration.sql</Item>
                    <Item>maps/data/effects-exploration.xml</Item>
                    <Item>maps/data/classes-exploration.sql</Item>
                </UpdateDatabase>
                <UpdateText>
                    <Item>maps/text/en_us/ResourceText.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>

        <ActionGroup id="mpt-maps-resources-modern" scope="game" criteria="maps-resources-modern">
            <Properties><LoadOrder>350</LoadOrder></Properties>
            <Actions>
                <ImportFiles>
                    <Item>maps/scripts/modern-resource-guarantee.js</Item>
                </ImportFiles>
                <UpdateDatabase>
                    <Item>maps/data/effects-reset.sql</Item>
                    <Item>maps/data/effects-common.xml</Item>
                    <Item>maps/data/effects-modern.sql</Item>
                    <Item>maps/data/effects-modern.xml</Item>
                    <Item>maps/data/classes-modern.sql</Item>
                </UpdateDatabase>
                <UpdateText>
                    <Item>maps/text/en_us/ResourceText.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
    </ActionGroups>

<!--************************* LOCALIZED TEXT ************************************************-->

    <LocalizedText>
        <File>text/en_us/mod-info-text.xml</File>
        <File>maps/text/en_us/MapText.xml</File>

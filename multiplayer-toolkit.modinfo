			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalance</ConfigurationId><Value>MPT_BALANCE_MULTIPLAYER</Value></ConfigurationValueMatches>

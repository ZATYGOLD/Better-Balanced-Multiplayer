        <ActionGroup id="mpt-balance-modern" scope="game" criteria="balance-modern">
            <Properties><LoadOrder>230</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>balance/data/sql/antiquity/civilizations.sql</Item>

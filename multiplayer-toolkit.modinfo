				</UpdateIcons>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-balance-exploration" scope="game" criteria="balance-exploration">
			<Properties><LoadOrder>220</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>balance/data/civilizations/antiquity.sql</Item>
					<Item>balance/data/civilizations/exploration.sql</Item>

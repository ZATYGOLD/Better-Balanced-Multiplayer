<!--*************************** MAPS (maps/) *******************************************************-->

		<ActionGroup id="mpt-maps-shell" scope="shell" criteria="always">
			<Properties><LoadOrder>300</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>maps/config/map-options.sql</Item>
					<Item>maps/config/multiplayer-only.sql</Item>
					<Item>maps/config/compatibility.sql</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>maps/text/en_us/map-options.xml</Item>
				</UpdateText>
				<UIScripts>
					<Item>maps/ui/multiplayer-defaults.js</Item>
					<Item>maps/ui/match-slots.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-maps-game" scope="game" criteria="always">
			<Properties><LoadOrder>300</LoadOrder></Properties>
			<Actions>
				<MapGenScripts>
					<Item>{multiplayer-toolkit}maps/scripts/global-team-starts.js</Item>
				</MapGenScripts>
				<UIScripts>
					<Item>maps/ui/start-bias-warning.js</Item>
				</UIScripts>
				<UpdateDatabase>
					<Item>maps/data/islands.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<!-- Duel placement: Tiny is built as the 44x28 Duel map. -->
		<ActionGroup id="mpt-maps-duel-map" scope="game" criteria="maps-duel-placement">
			<Properties><LoadOrder>304</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>maps/data/duel-map.sql</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>maps/text/en_us/map-options.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-maps-chosen-size-tiny" scope="game" criteria="maps-chosen-size-tiny">
			<Properties><LoadOrder>305</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>maps/data/chosen-size-tiny.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="mpt-maps-chosen-size-small" scope="game" criteria="maps-chosen-size-small">
			<Properties><LoadOrder>305</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>maps/data/chosen-size-small.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-maps-resource-system" scope="game" criteria="maps-resource-system-on">
			<Properties><LoadOrder>310</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>maps/data/resource-system.sql</Item>
					<Item>maps/data/density-standard.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-maps-resources-antiquity" scope="game" criteria="maps-resources-antiquity">
			<Properties><LoadOrder>350</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>maps/data/effects-reset.sql</Item>
					<Item>maps/data/effects-common.xml</Item>
					<Item>maps/data/effects-antiquity.sql</Item>
					<Item>maps/data/effects-antiquity.xml</Item>
					<Item>maps/data/classes-antiquity.sql</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>maps/text/en_us/resources.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-maps-resources-exploration" scope="game" criteria="maps-resources-exploration">
			<Properties><LoadOrder>350</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>maps/data/effects-reset.sql</Item>
					<Item>maps/data/effects-common.xml</Item>
					<Item>maps/data/effects-exploration.sql</Item>
					<Item>maps/data/effects-exploration.xml</Item>
					<Item>maps/data/classes-exploration.sql</Item>

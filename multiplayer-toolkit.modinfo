<!--*************************** GAMEPLAY (gameplay/) ***********************************************-->

		<!-- Lobby options, text and setup rules: always (the shell loads before any game option is known). -->
		<ActionGroup id="mpt-gameplay-shell" scope="shell" criteria="always">
			<Properties><LoadOrder>450</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>gameplay/config/gameplay-settings.sql</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>gameplay/text/en_us/gameplay-settings.xml</Item>
				</UpdateText>
				<UIScripts>
					<Item>gameplay/ui/gameplay-rules.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>

		<!-- Text in game, for the Custom Triumph Set. -->
		<ActionGroup id="mpt-gameplay-text" scope="game" criteria="always">
			<Properties><LoadOrder>450</LoadOrder></Properties>
			<Actions>
				<UpdateText>
					<Item>gameplay/text/en_us/gameplay-settings.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>


                    <Item>balance/data/pantheon/antiquity-record.xml</Item>
                    <Item>balance/data/pantheon/antiquity-record-gameeffects.xml</Item>
                    <Item>balance/data/xml/warwarry.xml</Item>
                </UpdateDatabase>
                <UpdateText>
                    <Item>balance/text/en_us/modern-text.sql</Item>
                    <Item>balance/text/en_us/exploration-text.sql</Item>
                    <Item>balance/text/en_us/antiquity-text.sql</Item>
                    <Item>balance/text/en_us/resources/antiquity.sql</Item>
                </UpdateText>
                <UpdateIcons>
                    <Item>balance/data/icons/antiquity-unit-icons.xml</Item>
                    <Item>balance/data/icons/pantheon-icons.xml</Item>
                </UpdateIcons>
            </Actions>
        </ActionGroup>

        <ActionGroup id="mpt-balance-exploration" scope="game" criteria="balance-exploration">
            <Properties><LoadOrder>220</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>balance/data/sql/antiquity/civilizations.sql</Item>
                    <Item>balance/data/sql/exploration/civilizations.sql</Item>
                    <Item>balance/data/sql/modern/civilizations.sql</Item>

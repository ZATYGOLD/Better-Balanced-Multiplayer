<?xml version="1.0" encoding="utf-8"?>
<Mod id="multiplayer-toolkit" version="00620" xmlns="ModInfo">
	<Properties>
		<Name>LOC_MODULE_MPT_NAME</Name>
		<Description>LOC_MODULE_MPT_DESCRIPTION</Description>
		<Authors>Zatygold, Gohei427</Authors>
		<Version>0.6.2</Version>
		<Package>Mod</Package>
		<LastUpdated>2026-11-07</LastUpdated>
		<ShowInBrowser>1</ShowInBrowser>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
		<Mod id="age-antiquity" title="LOC_MODULE_AGE_ANTIQUITY_NAME"/>
		<Mod id="age-exploration" title="LOC_MODULE_AGE_EXPLORATION_NAME"/>
		<Mod id="age-modern" title="LOC_MODULE_AGE_MODERN_NAME"/>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet/>
		</Criteria>

<!--*************************** CRITERIA: COMPETITIVE TIMER ****************************************-->

		<Criteria id="antiquity-age-current">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
		</Criteria>
		<Criteria id="exploration-age-current">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
		</Criteria>
		<Criteria id="modern-age-current">
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>

<!--*************************** CRITERIA: BALANCE *************************************************-->

		<!-- The Multiplayer Balance lobby option, alone, per Age and with its victory threshold option. -->
		<Criteria id="balance-on">
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalance</ConfigurationId><Value>MPT_BALANCE_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="balance-antiquity">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalance</ConfigurationId><Value>MPT_BALANCE_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="balance-exploration">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalance</ConfigurationId><Value>MPT_BALANCE_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="balance-modern">
			<AgeInUse>AGE_MODERN</AgeInUse>
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalance</ConfigurationId><Value>MPT_BALANCE_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="balance-victory-threshold-low">
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalance</ConfigurationId><Value>MPT_BALANCE_ON</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalanceVictoryThresholdScale</ConfigurationId><Value>MPT_BALANCE_VICTORY_THRESHOLD_LOW</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="balance-victory-threshold-very-low">
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalance</ConfigurationId><Value>MPT_BALANCE_ON</Value></ConfigurationValueMatches>
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>MPTBalanceVictoryThresholdScale</ConfigurationId><Value>MPT_BALANCE_VICTORY_THRESHOLD_VERY_LOW</Value></ConfigurationValueMatches>
		</Criteria>

<!--*************************** CRITERIA: MAPS ****************************************************-->

		<!-- The Custom Resource System lobby option (Map Options), alone and per Age. -->
		<Criteria id="maps-resource-system-on">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTResourceSystem</ConfigurationId><Value>MPT_MAPS_RESOURCE_SYSTEM_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-duel-placement">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTPlayerPlacement</ConfigurationId><Value>MPT_MAPS_PLACEMENT_DUEL</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-chosen-size-tiny">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTChosenMapSize</ConfigurationId><Value>MAPSIZE_TINY</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-chosen-size-small">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTChosenMapSize</ConfigurationId><Value>MAPSIZE_SMALL</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-resources-antiquity">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTResourceSystem</ConfigurationId><Value>MPT_MAPS_RESOURCE_SYSTEM_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-resources-exploration">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTResourceSystem</ConfigurationId><Value>MPT_MAPS_RESOURCE_SYSTEM_ON</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-resources-modern">
			<AgeInUse>AGE_MODERN</AgeInUse>
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTResourceSystem</ConfigurationId><Value>MPT_MAPS_RESOURCE_SYSTEM_ON</Value></ConfigurationValueMatches>
		</Criteria>
	</ActionCriteria>

<!--*************************** SHELL: TEXT/SETTINGS ***********************************************-->

	<ActionGroups>
		<ActionGroup id="mpt-shell" scope="shell" criteria="always">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UpdateText>
					<Item>text/en_us/mpt-text.xml</Item>
				</UpdateText>
				<UpdateDatabase>
					<Item>config/SetupParameters.sql</Item>
					<Item>config/mpt-input.sql</Item>
					<Item>config/rule-sets.sql</Item>
				</UpdateDatabase>
				<UIScripts>
					<Item>ui/mpt-shared/mpt-util.js</Item>
					<Item>ui/mp-lobby/mp-lobby-config.js</Item>
					<Item>ui/mp-lobby/mp-lobby-tooltips.js</Item>
					<Item>ui/mp-keybind/mp-keybind.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>

<!--***************************** GAME: TEXT & SHARED HELPERS *************************************-->

		<ActionGroup id="mpt-game-text" scope="game" criteria="always">
			<Properties><LoadOrder>500</LoadOrder></Properties>
			<Actions>
				<UpdateText>
					<Item>text/en_us/mpt-text.xml</Item>
				</UpdateText>
				<UIScripts>
					<Item>ui/mpt-shared/mpt-util.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>

<!--*************************** GAME: PAUSE BUTTON ***********************************************-->

		<ActionGroup id="mpt-pause-button" scope="game" criteria="always">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UIScripts>
					<Item>ui/mp-pause/mp-pause-config.js</Item>
					<Item>ui/mp-pause/mp-pause.scss.js</Item>
					<Item>ui/mp-pause/mp-pause-overlay.js</Item>
					<Item>ui/mp-pause/mp-pause-net.js</Item>
					<Item>ui/mp-pause/mp-pause-mgr.js</Item>
					<Item>ui/mp-keybind/mp-keybind.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>

<!--*********************** GAME: COMPETITIVE TIMER SCRIPT ***************************************-->

		<ActionGroup id="mpt-competitive-timer-script" scope="game" criteria="always">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UIScripts>
					<Item>ui/mp-timer/mp-timer-config.js</Item>
					<Item>ui/mp-timer/mp-timer.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>

<!--**************************** GAME: TURN TIMER ************************************************-->

		<ActionGroup id="mpt-turn-timer-schema" scope="game" criteria="always">
			<Properties><LoadOrder>900</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/timers/TimerScaling.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

	<!--**************************** TURN TIMER: COMPETITIVE *************************************-->

		<ActionGroup id="mpt-turn-timer-antiquity" scope="game" criteria="antiquity-age-current">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/timers/antiquity/CompetitiveTimer.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-turn-timer-exploration" scope="game" criteria="exploration-age-current">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/timers/exploration/CompetitiveTimer.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-turn-timer-modern" scope="game" criteria="modern-age-current">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/timers/modern/CompetitiveTimer.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

<!--*************************** MULTIPLAYER BALANCE (balance/) ************************************-->

		<!-- Lobby options and text: always (the shell loads before any game option is known). -->
		<ActionGroup id="mpt-balance-shell" scope="shell" criteria="always">
			<Properties><LoadOrder>200</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>balance/config/setup-parameters.sql</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>balance/text/en_us/general.xml</Item>
					<Item>balance/text/en_us/modern.xml</Item>
					<Item>balance/text/en_us/exploration.xml</Item>
					<Item>balance/text/en_us/antiquity.xml</Item>
					<Item>balance/text/en_us/mementos.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>

		<!-- Turn-phase presets: always, they back the lobby's default turn phase. -->
		<ActionGroup id="mpt-balance-turn-phases" scope="game" criteria="always">
			<Properties><LoadOrder>201</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>balance/data/turn-phases/turn-phases.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<!-- Everything below loads only with the Multiplayer Balance lobby option On. -->
		<ActionGroup id="mpt-balance-game" scope="game" criteria="balance-on">
			<Properties><LoadOrder>201</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>balance/data/mementos/mementos-gameeffects.xml</Item>
					<Item>balance/data/mementos/mementos.sql</Item>
					<Item>balance/data/city-states/city-states-gameeffects.xml</Item>
					<Item>balance/data/settlements/raze-rules-gameeffects.xml</Item>
					<Item>balance/data/settlements/raze-rules.xml</Item>
					<Item>balance/data/settlements/raze-dominion-gameeffects.xml</Item>
					<Item>balance/data/settlements/raze-dominion.xml</Item>
					<Item>balance/data/leaders/leaders-gameeffects.xml</Item>
					<Item>balance/data/leaders/leaders.xml</Item>
					<Item>balance/data/diplomacy/diplomacy.xml</Item>
					<Item>balance/data/diplomacy/diplomacy-gameeffects.xml</Item>
					<Item>balance/data/leaders/leaders.sql</Item>
					<Item>balance/data/units/units.sql</Item>
					<Item>balance/data/victories/victory-scoring.xml</Item>
					<Item>balance/data/happiness/happiness.xml</Item>
					<Item>balance/data/great-works/archaeology.sql</Item>
					<Item>balance/data/victories/thresholds-standard.sql</Item>
					<Item>balance/data/religion/altar.sql</Item>
					<Item>balance/data/religion/pantheon-carryover-tags.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>balance/text/en_us/general.xml</Item>
					<Item>balance/text/en_us/modern.xml</Item>
					<Item>balance/text/en_us/exploration.xml</Item>
					<Item>balance/text/en_us/antiquity.xml</Item>
					<Item>balance/text/en_us/mementos.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-balance-victory-threshold-low" scope="game" criteria="balance-victory-threshold-low">
			<Properties><LoadOrder>205</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>balance/data/victories/thresholds-low.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-balance-victory-threshold-very-low" scope="game" criteria="balance-victory-threshold-very-low">

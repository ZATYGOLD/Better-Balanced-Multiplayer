<!--*************************** SHELL: TEXT, SETTINGS, LOBBY UI, KEYBINDS *************************-->

	<ActionGroups>
		<ActionGroup id="mpt-shell" scope="shell" criteria="always">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UpdateText>
					<Item>text/en_us/mpt-text.xml</Item>
				</UpdateText>
				<UpdateDatabase>
					<Item>config/SetupParameters.sql</Item>
					<Item>config/mpt-input.sql</Item>
					<Item>config/rule-sets.sql</Item>
				</UpdateDatabase>
				<UIScripts>
					<Item>ui/mpt-shared/mpt-util.js</Item>
					<Item>ui/mp-lobby/mp-lobby-config.js</Item>
					<Item>ui/mp-lobby/mp-lobby-tooltips.js</Item>
					<Item>ui/mp-timer/mp-timer-config.js</Item>
					<Item>ui/mp-timer/mp-timer-lobby.js</Item>
					<Item>ui/mp-keybind/mp-keybind-config.js</Item>
					<Item>ui/mp-keybind/mp-keybind.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>

<!--*************************** GAME: TEXT & SHARED HELPERS ***************************************-->

		<ActionGroup id="mpt-game-text" scope="game" criteria="always">
			<Properties><LoadOrder>500</LoadOrder></Properties>
			<Actions>
				<UpdateText>
					<Item>text/en_us/mpt-text.xml</Item>
				</UpdateText>
				<UIScripts>
					<Item>ui/mpt-shared/mpt-util.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>

<!--*************************** GAME: PAUSE, KEYBINDS *********************************************-->

		<ActionGroup id="mpt-pause-button" scope="game" criteria="always">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UIScripts>
					<Item>ui/mp-pause/mp-pause-config.js</Item>
					<Item>ui/mp-pause/mp-pause.scss.js</Item>
					<Item>ui/mp-pause/mp-pause-overlay.js</Item>
					<Item>ui/mp-pause/mp-pause-net.js</Item>
					<Item>ui/mp-pause/mp-pause-mgr.js</Item>
					<Item>ui/mp-keybind/mp-keybind-config.js</Item>
					<Item>ui/mp-keybind/mp-keybind.js</Item>
					<Item>ui/mp-keybind/mp-hotkeys.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>

<!--*************************** GAME: COMPETITIVE TIMER (ui/mp-timer/) ****************************-->

		<ActionGroup id="mpt-competitive-timer-script" scope="game" criteria="always">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UIScripts>
					<Item>ui/mp-timer/mp-timer-config.js</Item>
					<Item>ui/mp-timer/mp-timer.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>

<!--*************************** GAME: COMPETITIVE TIMER DATA (data/timers/) ***********************-->

		<ActionGroup id="mpt-turn-timer-schema" scope="game" criteria="always">
			<Properties><LoadOrder>900</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/timers/TimerScaling.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<!-- Per-Age numbers over the defaults. -->
		<ActionGroup id="mpt-turn-timer-antiquity" scope="game" criteria="timer-antiquity">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/timers/antiquity/CompetitiveTimer.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-turn-timer-exploration" scope="game" criteria="timer-exploration">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/timers/exploration/CompetitiveTimer.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<ActionGroup id="mpt-turn-timer-modern" scope="game" criteria="timer-modern">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/timers/modern/CompetitiveTimer.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

<!--*************************** MULTIPLAYER BALANCE (balance/) ************************************-->

		<!-- Lobby options and text: always (the shell loads before any game option is known). -->
		<ActionGroup id="mpt-balance-shell" scope="shell" criteria="always">
			<Properties><LoadOrder>200</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>balance/config/setup-parameters.sql</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>balance/text/en_us/general.xml</Item>
					<Item>balance/text/en_us/modern.xml</Item>
					<Item>balance/text/en_us/exploration.xml</Item>
					<Item>balance/text/en_us/antiquity.xml</Item>
					<Item>balance/text/en_us/mementos.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>


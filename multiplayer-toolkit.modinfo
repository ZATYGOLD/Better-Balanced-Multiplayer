			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonderGreatBlueHole</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDER_OFF</Value></ConfigurationValueMatches>

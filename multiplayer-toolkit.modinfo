<!--*************************** SHELL: BALANCE ************************************************-->
		<ActionGroup id="mpt-balance-shell" scope="shell" criteria="always">
			<Properties><LoadOrder>200</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>config/balance.sql</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/en_us/balance-setup.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>

<!--*************************** GAME: BALANCE ************************************************-->
		<ActionGroup id="mpt-balance-text" scope="game" criteria="always">
			<Properties><LoadOrder>200</LoadOrder></Properties>
			<Actions>
				<UpdateText>
					<Item>text/en_us/balance-setup.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
		<ActionGroup id="mpt-balance-game" scope="game" criteria="balance-on">
			<Properties><LoadOrder>201</LoadOrder></Properties>
			<Actions>

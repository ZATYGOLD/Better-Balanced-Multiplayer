                    <Item>balance/data/xml/antiquity/attributes-gameeffects.xml</Item>
                    <Item>balance/data/sql/attributes.sql</Item>
                    <Item>balance/data/xml/antiquity/governments-gameeffects.xml</Item>
                    <Item>balance/data/xml/antiquity/governments.xml</Item>
                    <Item>balance/data/sql/antiquity/units.sql</Item>
                    <Item>balance/data/xml/antiquity/units-tier3.xml</Item>
                    <Item>balance/data/xml/antiquity/progression-trees.xml</Item>
                    <Item>balance/data/xml/antiquity/resources.xml</Item>
                    <Item>balance/data/xml/antiquity/resources-gameeffects.xml</Item>
                    <Item>balance/data/xml/antiquity/policies.xml</Item>

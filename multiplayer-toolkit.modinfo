		<Criteria id="maps-natural-wonder-off-gullfoss">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonderGullfoss</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDER_OFF</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-natural-wonder-off-hoerikwaggo">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonderHoerikwaggo</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDER_OFF</Value></ConfigurationValueMatches>
		</Criteria>
		<Criteria id="maps-natural-wonder-off-iguazu-falls">
			<ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MPTNaturalWonderIguazuFalls</ConfigurationId><Value>MPT_MAPS_NATURAL_WONDER_OFF</Value></ConfigurationValueMatches>

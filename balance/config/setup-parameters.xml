<?xml version="1.0" encoding="utf-8"?>
<Database>
	<Parameters>
		<!--
			Enable TurnPhaseType option in create mp game UI
		-->
		<Row ParameterID="TurnPhaseType"
			Name="LOC_GAME_TURNPHASE_TYPE"
			Description="LOC_GAME_TURNPHASE_DESC"
			Domain="StandardTurnPhases"
			Hash="1"
			DefaultValue="MBM_STANDARD"
			ConfigurationGroup="Game"
			ConfigurationKey="TurnPhaseType"
			GroupId="GameOptions"
			SupportsLANMultiplayer="0"
			SupportsInternetMultiplayer="1"
			SupportsSinglePlayer="0"
			ChangeableAfterGameStart="0"
			SortIndex="41"/>
		<Row ParameterID="PlayerMementoMinorSlot2" Name="LOC_PLAYER_MEMENTOS" Description="LOC_MEMENTOS_GENERAL_DESCRIPTION" Domain="StandardMementos" Hash="0" ConfigurationGroup="Player" ConfigurationKey="MinorMemento2" ValueConfigurationKey="MinorMemento2Value" GroupId="PlayerOptions" SupportsSinglePlayer="0" SortIndex="3032"/>
		<Row ParameterID="MBMVictoryThresholdScale"
			Name="LOC_MBM_VICTORY_THRESHOLD_SCALE_NAME"
			Description="LOC_MBM_VICTORY_THRESHOLD_SCALE_DESCRIPTION"
			Domain="MBMVictoryThresholdScales"
			Hash="0"
			DefaultValue="MBM_VICTORY_THRESHOLD_VERY_LOW"
			ConfigurationGroup="Game"
			ConfigurationKey="MBMVictoryThresholdScale"
			GroupId="VictoryOptions"
			GroupIDMultiplayerOverride="MPAdvancedVictoryOptions"
			SupportsSinglePlayer="0"
			ChangeableAfterGameStart="0"
			ChangeableAfterAgeTransition="0"
			UxHint="SimpleSelectWindow"
			SortIndex="4010"/>
		<!--
			MPT: the Multiplayer Balance option. On loads every balance change in
			this folder (modinfo criteria balance-*); Off keeps the game's own.
		-->
		<Row ParameterID="MPTBalance"
			Name="LOC_MPT_BALANCE_NAME"
			Description="LOC_MPT_BALANCE_DESC"
			Domain="MPTBalanceOptions"
			Hash="0"
			DefaultValue="MPT_BALANCE_ON"
			ConfigurationGroup="Game"
			ConfigurationKey="MPTBalance"
			GroupId="GameOptions"
			UxHint="SimpleSelectWindow"
			SupportsSinglePlayer="0"
			ChangeableAfterGameStart="0"
			SortIndex="45"/>
    </Parameters>

	<!-- Add domain values for the new turn phases -->
	<DomainValues>
		<!-- Add new turn phase options to the StandardTurnPhases domain -->
		<Row Domain="StandardTurnPhases" Value="MBM_STANDARD" Name="LOC_MBM_STANDARD" Description="LOC_MBM_STANDARD_DESC" SortIndex="50"/>
        <Row Domain="StandardTurnPhases" Value="MBM_BLITZ" Name="LOC_MBM_BLITZ" Description="LOC_MBM_BLITZ_DESC" SortIndex="60"/>
		<Row Domain="StandardTurnPhases" Value="MBM_CASUAL" Name="LOC_MBM_CASUAL" Description="LOC_MBM_CASUAL_DESC" SortIndex="70"/>
		<Row Domain="StandardTurnPhases" Value="MBM_COP" Name="LOC_MBM_COP" Description="LOC_MBM_COP_DESC" SortIndex="80"/>

		<!-- Victory threshold scaling options -->
		<Row Domain="MBMVictoryThresholdScales" Value="MBM_VICTORY_THRESHOLD_STANDARD" Name="LOC_MBM_VICTORY_THRESHOLD_STANDARD_NAME" Description="LOC_MBM_VICTORY_THRESHOLD_STANDARD_DESCRIPTION" SortIndex="10"/>
		<Row Domain="MBMVictoryThresholdScales" Value="MBM_VICTORY_THRESHOLD_LOW" Name="LOC_MBM_VICTORY_THRESHOLD_LOW_NAME" Description="LOC_MBM_VICTORY_THRESHOLD_LOW_DESCRIPTION" SortIndex="20"/>
		<Row Domain="MBMVictoryThresholdScales" Value="MBM_VICTORY_THRESHOLD_VERY_LOW" Name="LOC_MBM_VICTORY_THRESHOLD_VERY_LOW_NAME" Description="LOC_MBM_VICTORY_THRESHOLD_VERY_LOW_DESCRIPTION" SortIndex="30"/>

		<!-- MPT: Multiplayer Balance option -->
		<Row Domain="MPTBalanceOptions" Value="MPT_BALANCE_ON" Name="LOC_MPT_BALANCE_ON_NAME" Description="LOC_MPT_BALANCE_ON_DESC" SortIndex="10"/>
		<Row Domain="MPTBalanceOptions" Value="MPT_BALANCE_OFF" Name="LOC_MPT_BALANCE_OFF_NAME" Description="LOC_MPT_BALANCE_OFF_DESC" SortIndex="20"/>
    </DomainValues>
</Database>


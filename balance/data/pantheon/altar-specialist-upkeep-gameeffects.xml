<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
	<!--
		Specialists have a base upkeep of 1 Food and 1 Happiness. Current-Age
		buildings add another 1/3/5 upkeep in Antiquity/Exploration/Modern.
		The Altar is an ageless warehouse, so cancel that Age-based portion on
		plots containing an Altar and leave only warehouse-level upkeep.
	-->
	<Modifier id="MBM_ALTAR_SPECIALIST_UPKEEP_ANTIQUITY" collection="COLLECTION_ALL_PLOT_YIELDS" effect="EFFECT_PLOT_ADJUST_WORKER_MAINTENANCE">
		<OwnerRequirements>
			<Requirement type="REQUIREMENT_GAME_AGE_TYPE_MATCH">
				<Argument name="AgeType">AGE_ANTIQUITY</Argument>
			</Requirement>
		</OwnerRequirements>
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLOT_HAS_CONSTRUCTIBLE">
				<Argument name="ConstructibleType">BUILDING_ALTAR</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="YieldType">YIELD_FOOD, YIELD_HAPPINESS</Argument>
		<Argument name="Amount">-1</Argument>
	</Modifier>

	<Modifier id="MBM_ALTAR_SPECIALIST_UPKEEP_EXPLORATION" collection="COLLECTION_ALL_PLOT_YIELDS" effect="EFFECT_PLOT_ADJUST_WORKER_MAINTENANCE">
		<OwnerRequirements>
			<Requirement type="REQUIREMENT_GAME_AGE_TYPE_MATCH">
				<Argument name="AgeType">AGE_EXPLORATION</Argument>
			</Requirement>
		</OwnerRequirements>
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLOT_HAS_CONSTRUCTIBLE">
				<Argument name="ConstructibleType">BUILDING_ALTAR</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="YieldType">YIELD_FOOD, YIELD_HAPPINESS</Argument>
		<Argument name="Amount">-3</Argument>
	</Modifier>

	<Modifier id="MBM_ALTAR_SPECIALIST_UPKEEP_MODERN" collection="COLLECTION_ALL_PLOT_YIELDS" effect="EFFECT_PLOT_ADJUST_WORKER_MAINTENANCE">
		<OwnerRequirements>
			<Requirement type="REQUIREMENT_GAME_AGE_TYPE_MATCH">
				<Argument name="AgeType">AGE_MODERN</Argument>
			</Requirement>
		</OwnerRequirements>
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLOT_HAS_CONSTRUCTIBLE">
				<Argument name="ConstructibleType">BUILDING_ALTAR</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="YieldType">YIELD_FOOD, YIELD_HAPPINESS</Argument>
		<Argument name="Amount">-5</Argument>
	</Modifier>
</GameEffects>

<?xml version="1.0" encoding="utf-8"?>
<!-- First file: TurnPhases.xml -->
<Database>
    <Types>
        <Row Type="MBM_COP" Kind="KIND_TURNSEGMENT"/>

        <Row Type="MBM_STANDARD" Kind="KIND_TURNSEGMENT"/>
    
        <Row Type="MBM_BLITZ" Kind="KIND_TURNSEGMENT"/>

        <Row Type="MBM_CASUAL" Kind="KIND_TURNSEGMENT"/>
    
    </Types>

    <!-- Define the turn segments with the specific time parameters -->
    <TurnSegments>
        <!-- 45 seconds base, 5 seconds per settlement, 1 seconds per unit -->
        <Row TurnSegmentType="MBM_STANDARD_SINGLEPHASE" Name="" Sound="Play_MP_Strategic_Turn_Start" AllowStrategicCommands="true" AllowTacticalCommands="true" TimeLimit_Base="45" TimeLimit_PerCity="5" TimeLimit_PerUnit="1"/>
        <!-- 35 seconds base, 4 seconds per settlement, 1 seconds per unit -->
        <Row TurnSegmentType="MBM_COP_SINGLEPHASE" Name="" Sound="Play_MP_Strategic_Turn_Start" AllowStrategicCommands="true" AllowTacticalCommands="true" TimeLimit_Base="35" TimeLimit_PerCity="4" TimeLimit_PerUnit="1"/>
        <!-- 30 seconds base, 3 seconds per settlement, 1 second per unit -->
        <Row TurnSegmentType="MBM_BLITZ_SINGLEPHASE" Name="" Sound="Play_MP_Strategic_Turn_Start" AllowStrategicCommands="true" AllowTacticalCommands="true" TimeLimit_Base="30" TimeLimit_PerCity="3" TimeLimit_PerUnit="1"/>
        <!-- 35 seconds base, 4 seconds per settlement, 2 seconds per unit -->
        <Row TurnSegmentType="MBM_CASUAL_SINGLEPHASE" Name="" Sound="Play_MP_Strategic_Turn_Start" AllowStrategicCommands="true" AllowTacticalCommands="true" TimeLimit_Base="35" TimeLimit_PerCity="4" TimeLimit_PerUnit="2"/>
    
    
    </TurnSegments>

    <!-- Define the turn phases that combine the segments -->
    <TurnPhases>
        <Row TurnPhaseType="MBM_COP" PhaseOrder="0" TurnMode="TURNMODE_SIMULTANEOUS" ActiveSegmentType="MBM_COP_SINGLEPHASE"/>

        <Row TurnPhaseType="MBM_STANDARD" PhaseOrder="0" TurnMode="TURNMODE_SIMULTANEOUS" ActiveSegmentType="MBM_STANDARD_SINGLEPHASE"/>
    
        <Row TurnPhaseType="MBM_BLITZ" PhaseOrder="0" TurnMode="TURNMODE_SIMULTANEOUS" ActiveSegmentType="MBM_BLITZ_SINGLEPHASE"/>

        <Row TurnPhaseType="MBM_CASUAL" PhaseOrder="0" TurnMode="TURNMODE_SIMULTANEOUS" ActiveSegmentType="MBM_CASUAL_SINGLEPHASE"/>
    
    </TurnPhases>
</Database>

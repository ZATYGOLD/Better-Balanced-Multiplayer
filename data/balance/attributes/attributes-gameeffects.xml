<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
	<!-- Diplomatic: Influence per Age in every City. -->
	<Modifier id="MPT_BALANCE_MOD_ATTRIBUTE_POLITICAL_CITY_INFLUENCE" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_CITY_IS_CITY"/>
		</SubjectRequirements>
		<Argument name="YieldType">YIELD_DIPLOMACY</Argument>
		<Argument name="Amount" type="ScaleByGameAge" extra="100">1</Argument>
		<Argument name="Tooltip">LOC_TREE_ATTRIBUTE_POLITICAL</Argument>
		<String context="Description">LOC_MOD_ATTRIBUTE_POLITICAL_02_DESCRIPTION</String>
	</Modifier>

	<!-- Diplomatic: the response discount also applies when sending actions. -->
	<Modifier id="MPT_BALANCE_MOD_ATTRIBUTE_POLITICAL_SEND_EFFICIENCY" collection="COLLECTION_OWNER" effect="EFFECT_DIPLOMACY_ADJUST_DIPLOMATIC_ACTION_TYPE_EFFICIENCY">
		<Argument name="ActionGroupType">DIPLOMACY_ACTION_GROUP_TREATY, DIPLOMACY_ACTION_GROUP_ENDEAVOR, DIPLOMACY_ACTION_GROUP_SANCTION, DIPLOMACY_ACTION_GROUP_ESPIONAGE, DIPLOMACY_ACTION_GROUP_PROJECT, DIPLOMACY_ACTION_GROUP_UNIQUE</Argument>
		<Argument name="Percent">25</Argument>
	</Modifier>

	<!-- Militaristic: garrisoned Commanders' yields per level. One id in every Age, so a
	     completed node keeps it through Age transitions (unlocks are not re-fired). -->
	<Modifier id="MPT_BALANCE_MOD_ATTRIBUTE_MILITARISTIC_GARRISON_CULTURE" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_COMMANDER_LEVEL">
		<Argument name="YieldType">YIELD_CULTURE</Argument>
		<Argument name="Amount">1</Argument>
		<Argument name="Tooltip">LOC_TREE_ATTRIBUTE_MILITARISTIC</Argument>
		<String context="Description">LOC_MOD_ATTRIBUTE_MILITARISTIC_06_DESCRIPTION</String>
	</Modifier>
	<Modifier id="MPT_BALANCE_MOD_ATTRIBUTE_MILITARISTIC_GARRISON_SCIENCE" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_COMMANDER_LEVEL">
		<Argument name="YieldType">YIELD_SCIENCE</Argument>
		<Argument name="Amount">1</Argument>
		<Argument name="Tooltip">LOC_TREE_ATTRIBUTE_MILITARISTIC</Argument>
	</Modifier>

	<!-- Militaristic: Gold after defeating an Independent or City-State unit. -->
	<Modifier id="MPT_BALANCE_MOD_ATTRIBUTE_MILITARISTIC_MINOR_KILL_GOLD" collection="COLLECTION_PLAYER_COMBAT" effect="EFFECT_ADJUST_UNIT_POST_COMBAT_YIELD">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_OPPONENT_IS_MINOR_CIV"/>
		</SubjectRequirements>
		<Argument name="YieldType">YIELD_GOLD</Argument>
		<Argument name="PercentDefeatedStrength">50</Argument>
		<String context="WorldText">LOC_WORLD_GOLD_INCREASE_FLOATER</String>
	</Modifier>
</GameEffects>

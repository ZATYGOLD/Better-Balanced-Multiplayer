<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
	<!-- Diplomatic: Influence per Age in every City. -->
	<Modifier id="BBM_BALANCE_MOD_ATTRIBUTE_POLITICAL_CITY_INFLUENCE" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_CITY_IS_CITY"/>
		</SubjectRequirements>
		<Argument name="YieldType">YIELD_DIPLOMACY</Argument>
		<Argument name="Amount" type="ScaleByGameAge" extra="100">1</Argument>
		<Argument name="Tooltip">LOC_TREE_ATTRIBUTE_POLITICAL</Argument>
		<String context="Description">LOC_MOD_ATTRIBUTE_POLITICAL_02_DESCRIPTION</String>
	</Modifier>

	<!-- Diplomatic: the response discount also applies when sending actions. -->
	<Modifier id="BBM_BALANCE_MOD_ATTRIBUTE_POLITICAL_SEND_EFFICIENCY" collection="COLLECTION_OWNER" effect="EFFECT_DIPLOMACY_ADJUST_DIPLOMATIC_ACTION_TYPE_EFFICIENCY">
		<Argument name="ActionGroupType">DIPLOMACY_ACTION_GROUP_TREATY, DIPLOMACY_ACTION_GROUP_ENDEAVOR, DIPLOMACY_ACTION_GROUP_SANCTION, DIPLOMACY_ACTION_GROUP_ESPIONAGE, DIPLOMACY_ACTION_GROUP_PROJECT, DIPLOMACY_ACTION_GROUP_UNIQUE</Argument>
		<Argument name="Percent">25</Argument>
	</Modifier>

	<!-- Militaristic: garrisoned Commanders' Science and Culture per level. A Commander
	     gets a Promotion with each level, so tier 1 counts every Commander and tier N needs
	     N Promotions, up to 30 (every Promotion a Commander can take). One id in every
	     Age, so a completed node keeps it through Age transitions (unlocks are not re-fired). -->
	<Modifier id="BBM_BALANCE_MOD_ATTRIBUTE_MILITARISTIC_GARRISON_01" collection="COLLECTION_PLAYER_UNITS" effect="EFFECT_ATTACH_MODIFIERS">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_UNIT_TAG_MATCHES">
				<Argument name="Tag">UNIT_CLASS_COMMAND</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="ModifierId">BBM_BALANCE_MOD_ATTRIBUTE_MILITARISTIC_GARRISON_01_YIELDS</Argument>
		<String context="Description">LOC_MOD_ATTRIBUTE_MILITARISTIC_06_DESCRIPTION</String>
	</Modifier>
	<Modifier id="BBM_BALANCE_MOD_ATTRIBUTE_MILITARISTIC_GARRISON_01_YIELDS" collection="COLLECTION_UNIT_OCCUPIED_CITY" effect="EFFECT_CITY_ADJUST_YIELD">

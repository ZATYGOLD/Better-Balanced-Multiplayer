<?xml version="1.0" encoding="utf-8"?>
<!-- Game Balance: Happiness penalties for unhappy Settlements. -->
<Database>
	<GlobalParameters>
		<!-- Unhappy Settlements lose 3% of applicable yields per Happiness deficit, capped at 40%. -->
		<Replace name="CITY_YIELD_PENALTY_PERCENT_PER_HAPPINESS_DEFICIT" value="-3"/>
		<Replace name="CITY_YIELD_PENALTY_PERCENT_PER_HAPPINESS_CAP" value="-40"/>
	</GlobalParameters>
</Database>

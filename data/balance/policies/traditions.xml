	<ModifierArguments>
		<!-- Ju Xian I and II share this Specialist Science modifier. -->
		<Update><Where ModifierId="MOD_TRADITION_JU_XIAN_SPECIALIST_SCIENCE" Name="Amount"/><Set Value="2"/></Update>
		<!-- Inca -->
		<Update><Where ModifierId="QULLQA_I_TRADE_ROUTE_FOOD" Name="Amount"/><Set Value="2"/></Update>
		<Update><Where ModifierId="TIRAKUNA_I_MOUNTAIN_ADJACENCY" Name="ConstructibleAdjacency"/><Set Value="IncaMountainFoodAdjacency, IncaMountainGoldAdjacency"/></Update>
		<Update><Where ModifierId="TIRAKUNA_II_MOUNTAIN_ADJACENCY" Name="ConstructibleAdjacency"/><Set Value="BBMBalanceTirakunaIIMountainFood, BBMBalanceTirakunaIIMountainGold"/></Update>
		<!-- Shusei Kokubo retains Military and Science Buildings and adds Production Buildings. -->
		<Update><Where ModifierId="SHUSEI_KOKUBO_I_MOD_BUILDING_PRODUCTION" Name="Tag"/><Set Value="MILITARY, SCIENCE, PRODUCTION"/></Update>
		<!-- O-yatoi Gaikokujin II increases both Specialist yields to +2. -->
		<Update><Where ModifierId="O_YATOI_GAIKOKUJIN_II_MOD_WORKER_PRODUCTION" Name="Amount"/><Set Value="2"/></Update>
		<Update><Where ModifierId="O_YATOI_GAIKOKUJIN_II_MOD_WORKER_SCIENCE" Name="Amount"/><Set Value="2"/></Update>
	</ModifierArguments>


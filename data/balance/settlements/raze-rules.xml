<?xml version="1.0" encoding="utf-8"?>
<!-- Game Balance: a Settlement being razed does not count toward the Settlement Limit. -->
<Database>
	<TraitModifiers>
		<Row TraitType="TRAIT_ANTIQUITY_CIV" ModifierId="BBM_BALANCE_MOD_RAZING_SETTLEMENT_CAP_OFFSET"/>
		<Row TraitType="TRAIT_EXPLORATION_CIV" ModifierId="BBM_BALANCE_MOD_RAZING_SETTLEMENT_CAP_OFFSET"/>
		<Row TraitType="TRAIT_MODERN_CIV" ModifierId="BBM_BALANCE_MOD_RAZING_SETTLEMENT_CAP_OFFSET"/>
		<Row TraitType="TRAIT_ANACHRONISTIC_CIV" ModifierId="BBM_BALANCE_MOD_RAZING_SETTLEMENT_CAP_OFFSET"/>
	</TraitModifiers>

	<!-- Halve Firaxis's existing completed-raze penalty from -2 to -1 Influence per Age level. -->
	<ModifierArguments>
		<Update>
			<Where ModifierId="TRAIT_MOD_NEGATIVE_INFLUENCE_RAZED_SETTLEMENTS" Name="Amount"/>
			<Set Value="-1"/>
		</Update>
	</ModifierArguments>
</Database>

<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
	<!-- Military Aid: Production towards Military Units instead of Combat Strength. -->
	<Modifier id="BBM_BALANCE_PLAYER_DIPLOMACY_MILITARY_AID_COMPLETE" collection="COLLECTION_OWNER" effect="EFFECT_DAE_COOPERATIVE_ATTACH_MODIFIER">
		<String context="Name">LOC_DIPLOMACY_PROJECT_MILITARY_AID_NAME</String>
		<Argument name="InitialPlayerAccept">BBM_BALANCE_PLAYER_DIPLOMACY_MILITARY_AID_INITIAL_PLAYER_ACCEPT</Argument>
		<Argument name="TargetPlayerAccept">PLAYER_DIPLOMACY_MILITARY_AID_TARGET_PLAYER_ACCEPT</Argument>
		<Argument name="InitialPlayerSupport">BBM_BALANCE_PLAYER_DIPLOMACY_MILITARY_AID_SUPPORT</Argument>
		<Argument name="TargetPlayerSupport">BBM_BALANCE_PLAYER_DIPLOMACY_MILITARY_AID_SUPPORT</Argument>
	</Modifier>
	<Modifier id="BBM_BALANCE_PLAYER_DIPLOMACY_MILITARY_AID_INITIAL_PLAYER_ACCEPT" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_UNIT_PRODUCTION">
		<Argument name="UnitClass">UNIT_CLASS_COMBAT</Argument>
		<Argument name="Percent">10</Argument>
	</Modifier>
	<Modifier id="BBM_BALANCE_PLAYER_DIPLOMACY_MILITARY_AID_SUPPORT" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_UNIT_PRODUCTION">
		<Argument name="UnitClass">UNIT_CLASS_COMBAT</Argument>
		<Argument name="Percent">15</Argument>
	</Modifier>
</GameEffects>
